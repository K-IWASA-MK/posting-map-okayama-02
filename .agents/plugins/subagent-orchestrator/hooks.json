{
  "auditor-guard": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/plugins/subagent-orchestrator/scripts/guard_auditor.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
